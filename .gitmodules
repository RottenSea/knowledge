[submodule "vendor/design/dsds"]
	path = vendor/design/dsds
	url = https://github.com/somerandomdude/design-system-documentation-schema.git
	branch = main
[submodule "vendor/design/dtcg"]
	path = vendor/design/dtcg
	url = https://github.com/design-tokens/community-group.git
	branch = main
[submodule "vendor/a11y/wcag"]
	path = vendor/a11y/wcag
	url = https://github.com/w3c/wcag.git
	branch = main
	shallow = true
[submodule "vendor/a11y/apg"]
	path = vendor/a11y/apg
	url = https://github.com/w3c/aria-practices.git
	branch = main
[submodule "vendor/conventions/github-docs"]
	path = vendor/conventions/github-docs
	url = https://github.com/github/docs.git
	branch = main
	shallow = true
[submodule "vendor/conventions/keep-a-changelog"]
	path = vendor/conventions/keep-a-changelog
	url = https://github.com/olivierlacan/keep-a-changelog.git
	branch = main
[submodule "vendor/conventions/semantic-versioning-specification"]
	path = vendor/conventions/semantic-versioning-specification
	url = https://github.com/semver/semver.git
	branch = master
[submodule "vendor/conventions/conventional-commits"]
	path = vendor/conventions/conventional-commits
	url = https://github.com/conventional-commits/conventionalcommits.org.git
	branch = master
[submodule "vendor/conventions/standard-readme"]
	path = vendor/conventions/standard-readme
	url = https://github.com/RichardLitt/standard-readme.git
	branch = main
[submodule "vendor/tooling/vitepress"]
	path = vendor/tooling/vitepress
	url = https://github.com/vuejs/vitepress.git
	branch = v1
	shallow = true
[submodule "vendor/tooling/vite"]
	path = vendor/tooling/vite
	url = https://github.com/vitejs/vite.git
	branch = v5
	shallow = true
